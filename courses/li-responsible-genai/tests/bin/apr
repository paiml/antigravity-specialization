#!/usr/bin/env bash
# Test stand-in for the apr CLI: canned output, no model, no network. Put tests/bin first on PATH.
case "${1:-}" in
  --version) echo "apr 0.0.0-test (stub)" ;;
  list)
    echo "=== Cached Models ==="
    echo "NAME   SIZE   FORMAT   PATH"
    echo "m1     1 GB   APR      $HOME/.cache/pacha/models/m1.apr"
    ;;
  pull) echo "would pull $3" ;;
  inspect)
    echo "Model: stub"
    case "${APR_INSPECT_MODE:-missing}" in
      missing) printf '  Architecture:\n    Family: qwen2\n  Provenance:\n    license: (missing)\n    data_source: (missing)\n    data_license: (missing)\n' ;;
      present) printf '  Architecture:\n    Family: qwen2\n  Provenance:\n    license: apache-2.0\n    data_source: web\n    data_license: cc\n' ;;
      none) printf '  Architecture:\n    Family: qwen2\n' ;;
    esac
    ;;
  run)
    printf 'Source: %s\n\nOutput:\n%s\n\nCompleted in 1s\n' "$HOME/model.apr" "${APR_RUN_ANSWER-Paris}"
    ;;
  serve) echo "serve stub: $*" ;;
  *) echo "apr stub: unknown command $*" >&2; exit 2 ;;
esac
